@model LessonFormViewModel
@{ ViewData["Title"] = "Create Lesson"; }
<div class="form-shell"><div class="eyebrow">CURRICULUM BUILDER</div><h1>Create lesson chapter</h1><p class="text-muted">Course: @Model.CourseTitle · Build three chapters for every study day.</p><form asp-action="Create" asp-route-courseId="@Model.CourseId" method="post" enctype="multipart/form-data" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div><div class="col-md-4"><label asp-for="DayNumber" class="form-label"></label><input asp-for="DayNumber" class="form-control" min="1" /></div><div class="col-md-8"><label asp-for="Chapter" class="form-label"></label><input asp-for="Chapter" class="form-control" placeholder="Chapter 1 — Core concepts" /></div><div class="col-md-4"><label asp-for="EstimatedMinutes" class="form-label"></label><input asp-for="EstimatedMinutes" class="form-control" /></div><div class="col-md-4"><label asp-for="OrderIndex" class="form-label"></label><input asp-for="OrderIndex" class="form-control" /></div><div class="col-12"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" class="form-control" rows="12"></textarea><div class="form-text">Write objectives, explanation, real-world example, practice task and reflection prompts.</div></div><div class="col-md-6"><label asp-for="VideoUrl" class="form-label"></label><input asp-for="VideoUrl" class="form-control" /></div><div class="col-md-6"><label asp-for="AudioUrl" class="form-label"></label><input asp-for="AudioUrl" class="form-control" /></div><div class="col-12"><label asp-for="ImageFile" class="form-label"></label><input asp-for="ImageFile" class="form-control" /></div><div class="col-12"><button class="btn btn-ss-primary">Save chapter</button></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
