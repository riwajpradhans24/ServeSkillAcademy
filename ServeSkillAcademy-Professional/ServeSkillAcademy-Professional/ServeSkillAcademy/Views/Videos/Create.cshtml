@model VideoFormViewModel
@{ ViewData["Title"] = "Add Learning Video"; }
<div class="form-shell"><div class="eyebrow">VIDEO LIBRARY</div><h1>Add learning video</h1><p class="text-muted">Course: @Model.CourseTitle</p><form asp-action="Create" asp-route-courseId="@Model.CourseId" method="post" class="row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-md-4"><label asp-for="DurationMinutes" class="form-label"></label><input asp-for="DurationMinutes" class="form-control" /></div><div class="col-12"><label asp-for="VideoUrl" class="form-label"></label><input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." /><span asp-validation-for="VideoUrl" class="text-danger"></span></div><div class="col-12"><label asp-for="ThumbnailUrl" class="form-label"></label><input asp-for="ThumbnailUrl" class="form-control" placeholder="Optional thumbnail URL" /></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-md-4"><label asp-for="OrderIndex" class="form-label"></label><input asp-for="OrderIndex" class="form-control" /></div><div class="col-md-4 form-check mt-5 ms-3"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label">Published</label></div><div class="col-12"><button class="btn btn-ss-primary">Save video</button><a class="btn btn-link" asp-controller="Videos" asp-action="ForCourse" asp-route-courseId="@Model.CourseId">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
