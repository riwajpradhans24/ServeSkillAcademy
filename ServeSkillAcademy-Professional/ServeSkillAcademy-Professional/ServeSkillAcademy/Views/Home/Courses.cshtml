@model List<Course>
@{ ViewData["Title"] = "Course Catalog"; var categories = ViewBag.Categories as List<Category>; }
<div class="catalog-hero"><div class="container py-5"><span class="hero-kicker">LEARN · PRACTISE · CERTIFY</span><h1 class="display-4 fw-bold">Professional learning pathways.</h1><p class="lead mb-0">Explore the full curriculum before you register. Lessons, chapters, videos and assessments are visible to everyone; playback and learning progress are for students.</p></div></div>
<div class="container py-5">
<form method="get" asp-action="Courses" class="card border-0 shadow-sm p-3 mb-5 rounded-4"><div class="row g-2"><div class="col-md-6"><input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-lg" placeholder="Search courses..." /></div>
<div class="col-md-4"><select name="categoryId" class="form-select form-select-lg"><option value="">All categories</option>@foreach(var cat in categories ?? new List<Category>()){<option value="@cat.CategoryId">@cat.Name</option>}</select></div><div class="col-md-2"><button class="btn btn-ss-primary btn-lg w-100">Search</button></div></div></form>
<div class="row g-4">@foreach(var course in Model){var advanced=course.Level=="Advanced";<div class="col-md-6 col-xl-4"><div class="card course-card h-100 border-0 shadow-sm"><div class="position-relative"><img src="@(course.ThumbnailUrl ?? "/images/course-placeholder.jpg")" class="card-img-top" alt="@course.Title"><span class="position-absolute top-0 end-0 m-3 badge @(advanced?"bg-dark":"bg-success")">@course.Level</span></div><div class="card-body d-flex flex-column p-4"><div class="small text-muted">@course.Category?.Name · @course.DurationDays days</div><h4 class="mt-2">@course.Title</h4><p class="text-muted">@(course.Description.Length > 115 ? course.Description[..115] + "…" : course.Description)</p><div class="d-flex gap-3 small text-muted mb-3"><span>📖 @course.Lessons.Count chapters</span><span>🎬 @course.Videos.Count videos</span></div><div class="mt-auto d-flex align-items-center justify-content-between"><strong>@(course.Price==0?"FREE":$"NPR {course.Price:N0}")</strong><a class="btn btn-outline-dark" asp-action="CourseDetails" asp-route-id="@course.CourseId">View Course</a></div></div></div></div>}</div>
@if(!Model.Any()){<p class="text-muted">No courses match your search.</p>}</div>
