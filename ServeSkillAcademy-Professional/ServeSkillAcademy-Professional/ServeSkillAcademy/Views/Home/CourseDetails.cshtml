@model Course
@{ ViewData["Title"] = Model.Title; var advanced = Model.Level.Equals("Advanced", StringComparison.OrdinalIgnoreCase); var days = Model.Lessons.GroupBy(l=>l.DayNumber).OrderBy(g=>g.Key); var isEnrolled = (bool)(ViewBag.IsEnrolled ?? false); }
<div class="course-hero"><div class="container py-5"><div class="row align-items-center g-5"><div class="col-lg-7"><div class="d-flex gap-2 flex-wrap mb-3"><span class="badge course-level">@Model.Level</span><span class="badge course-category">@Model.Category?.Name</span><span class="badge course-category">@Model.DurationDays-day pathway</span></div><h1 class="display-4 fw-bold">@Model.Title</h1><p class="lead text-muted">@Model.Description</p><div class="hero-meta"><span>📚 @Model.Lessons.Count chapters</span><span>🎬 @Model.Videos.Count videos</span><span>🧠 @Model.Quizzes.Count assessments</span><span>🏅 Certificate badge</span></div></div><div class="col-lg-5"><img class="course-cover-large" src="@(Model.ThumbnailUrl ?? "/images/course-placeholder.jpg")" alt="@Model.Title" /></div></div></div></div>
<div class="container py-5"><div class="row g-5"><div class="col-lg-8">
<section class="section-block"><div class="eyebrow">WHAT YOU WILL LEARN</div><h2>A guided pathway, not a collection of buttons</h2><p class="text-muted">Every day contains three chapters: concepts, workplace workflow and applied practice. Complete the chapters in order, then pass the assessment to earn your badge.</p></section>
<section class="section-block"><div class="d-flex justify-content-between align-items-end mb-4"><div><div class="eyebrow">CURRICULUM</div><h2>Day-by-day learning plan</h2></div><span class="small text-muted">@Model.Lessons.Count chapters total</span></div>
@foreach(var day in days){<div class="day-card mb-4"><div class="day-heading"><div><span class="day-number">@day.Key</span><div><strong>Day @day.Key</strong><div class="small text-muted">@day.Count() chapters · @day.Sum(x=>x.EstimatedMinutes) min guided study</div></div></div><span class="badge bg-soft-green">3 chapters</span></div><div class="chapter-list">@foreach(var l in day.OrderBy(x=>x.OrderIndex)){<div class="chapter-row"><div class="chapter-index">@(((l.OrderIndex-1)%3)+1)</div><div class="flex-grow-1"><strong>@l.Chapter</strong><div class="text-muted">@l.Title</div></div><span class="small text-muted">@l.EstimatedMinutes min</span><span class="locked-pill">🔒</span></div>}</div></div>}
</section>
<section class="section-block"><div class="eyebrow">LEARNING VIDEOS</div><h2>Watch, learn and practise</h2><div class="row g-3">@foreach(var v in Model.Videos.Where(x=>x.IsPublished).OrderBy(x=>x.OrderIndex)){<div class="col-md-6"><div class="video-card"><div class="video-thumb">@if(!string.IsNullOrWhiteSpace(v.ThumbnailUrl)){<img src="@v.ThumbnailUrl" alt="@v.Title" />}else{<span>▶</span>}</div><div class="p-3"><div class="d-flex justify-content-between"><strong>@v.Title</strong><span class="small text-muted">@v.DurationMinutes min</span></div><p class="small text-muted mt-2 mb-2">@(v.Description ?? "Guided course video")</p>@if(isEnrolled){<a class="btn btn-sm btn-ss-primary" asp-controller="Learner" asp-action="Video" asp-route-id="@v.VideoId">Watch video</a>}else if(User.Identity?.IsAuthenticated==true && User.IsInRole("Learner")){<span class="small text-success">Enrol in this course to unlock playback.</span>}else{<a class="small fw-semibold text-decoration-none" asp-controller="Account" asp-action="Register">🔒 Sign in as a student to watch</a>}</div></div></div>}@if(!Model.Videos.Any()){<div class="empty-inline"><span>🎬</span><div><strong>Video library coming soon</strong><p class="text-muted mb-0">The academy admin can publish course videos from the admin portal.</p></div></div>}</div></section>
<section class="section-block"><div class="eyebrow">ASSESSMENT</div><h2>Professional quizzes</h2>@foreach(var q in Model.Quizzes){<div class="assessment-card"><div class="assessment-icon">✓</div><div><strong>@q.Title</strong><p class="small text-muted mb-0">Final assessment · Pass mark @q.PassPercentage% · Attempts are recorded on your learner dashboard.</p></div><span class="badge bg-soft-green">@q.PassPercentage% pass</span></div>}</section>
</div><div class="col-lg-4"><div class="enroll-card sticky-top" style="top:95px"><div class="small text-uppercase fw-bold text-muted">COURSE ACCESS</div><div class="price">@(Model.Price==0?"Free":$"NPR {Model.Price:N0}")</div><p class="text-muted">@Model.DurationDays days · @Model.Lessons.Count chapters</p><ul class="feature-list"><li>Three chapters per day</li><li>Detailed workplace scenarios</li><li>Learning video library</li><li>Progress tracking</li><li>Professional assessment</li><li>Completion badge</li></ul>@if(User.Identity?.IsAuthenticated==true && User.IsInRole("Learner")){if(Model.Price==0){<form asp-controller="Learner" asp-action="Enroll" method="post">@Html.AntiForgeryToken()<input type="hidden" name="courseId" value="@Model.CourseId"/><button class="btn btn-ss-primary btn-lg w-100">Start free pathway</button></form>}else{<a class="btn btn-ss-primary btn-lg w-100" asp-controller="Payment" asp-action="Checkout" asp-route-courseId="@Model.CourseId">Unlock advanced course</a>}}else{<a class="btn btn-ss-primary btn-lg w-100" asp-controller="Account" asp-action="Register">Create student account</a><a class="btn btn-link w-100 mt-2" asp-controller="Account" asp-action="Login">Already a student? Sign in</a>}<div class="payment-strip mt-3"><span>eSewa</span><span>Bank</span><span>Card</span></div></div></div></div></div>
