@{ ViewData["Title"] = "Admin Dashboard"; }

<h1 class="mb-4">Admin Dashboard</h1>
<div class="row g-4">
    <div class="col-md-3">
        <div class="card ss-card p-3 text-center">
            <h2>@ViewBag.TotalUsers</h2>
            <p class="text-muted mb-0">Total Users</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card ss-card p-3 text-center">
            <h2>@ViewBag.TotalCourses</h2>
            <p class="text-muted mb-0">Total Courses (@ViewBag.PublishedCourses published)</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card ss-card p-3 text-center">
            <h2>@ViewBag.TotalEnrollments</h2>
            <p class="text-muted mb-0">Enrollments</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card ss-card p-3 text-center">
            <h2>@ViewBag.TotalQuizAttempts</h2>
            <p class="text-muted mb-0">Quiz Attempts</p>
        </div>
    </div>
</div>

<div class="mt-5">
    <a class="btn btn-ss-primary me-2" asp-controller="Courses" asp-action="Create">+ New Course</a>
    <a class="btn btn-outline-dark" asp-controller="Categories" asp-action="Create">+ New Category</a>
</div>
