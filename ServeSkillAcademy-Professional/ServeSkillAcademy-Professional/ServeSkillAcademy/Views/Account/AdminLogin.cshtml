@model LoginViewModel
@{ ViewData["Title"] = "Admin Portal"; }
<div class="auth-page"><div class="auth-card"><div class="auth-brand">◆ ServeSkill <span>ADMIN</span></div><h1>Administrator portal</h1><p class="text-muted">Manage courses, chapters, videos, assessments and payments.</p><form asp-action="AdminLogin" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="ReturnUrl"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control form-control-lg"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control form-control-lg"/><span asp-validation-for="Password" class="text-danger"></span></div><div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label">Keep me signed in</label></div><button class="btn btn-ss-primary btn-lg w-100">Enter admin portal</button></form><a class="btn btn-link w-100 mt-3" asp-action="Login">Student login instead</a></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
