@model LearnerDashboardViewModel
@{ ViewData["Title"] = "Student Dashboard"; }
<div class="dashboard-hero"><div class="container py-5"><div class="d-flex justify-content-between align-items-end flex-wrap gap-3"><div><span class="eyebrow">STUDENT PORTAL</span><h1>Welcome back, @Model.FullName.</h1><p class="text-muted mb-0">Your learning journey, progress and achievements in one place.</p></div><a class="btn btn-ss-primary" asp-controller="Home" asp-action="Courses">Explore more courses</a></div></div></div>
<div class="container py-5"><div class="row g-4 mb-5"><div class="col-md-4"><div class="dashboard-stat"><span>COURSES</span><strong>@Model.EnrolledCourses.Count</strong><small>Active learning pathways</small></div></div><div class="col-md-4"><div class="dashboard-stat"><span>BADGES</span><strong>@Model.Badges.Count</strong><small>Achievements earned</small></div></div><div class="col-md-4"><div class="dashboard-stat"><span>ASSESSMENTS</span><strong>@Model.RecentQuizScores.Count</strong><small>Recent quiz attempts</small></div></div></div>
<div class="section-heading"><div><span class="eyebrow">MY LEARNING</span><h2>Continue your pathways</h2></div></div><div class="row g-4 mb-5">@foreach(var c in Model.EnrolledCourses){<div class="col-md-6 col-xl-4"><div class="premium-card h-100"><img class="dashboard-course-image" src="@(c.ThumbnailUrl ?? "/images/course-placeholder.jpg")" alt="@c.Title"/><div class="p-4"><div class="d-flex justify-content-between"><span class="small text-muted">Learning progress</span><strong>@c.ProgressPercentage%</strong></div><div class="progress mt-2 mb-3"><div class="progress-bar" style="width:@c.ProgressPercentage%"></div></div><h5>@c.Title</h5>@if(c.IsCompleted){<div class="completed-banner small">✓ Course completed</div>}<a class="btn btn-ss-primary w-100 mt-3" asp-controller="Learner" asp-action="Lesson" asp-route-courseId="@c.CourseId">@(c.IsCompleted?"Review pathway":"Continue learning")</a></div></div></div>}@if(!Model.EnrolledCourses.Any()){<div class="empty-state"><div class="empty-icon">📚</div><h4>Your dashboard is ready</h4><p>Choose a free or advanced pathway to begin.</p><a class="btn btn-ss-primary" asp-controller="Home" asp-action="Courses">Browse courses</a></div>}</div>
<div class="row g-5"><div class="col-lg-7"><div class="section-heading"><div><span class="eyebrow">ASSESSMENTS</span><h3>Recent quiz performance</h3></div></div><div class="assessment-list">@foreach(var s in Model.RecentQuizScores){<div class="assessment-row"><div><strong>@s.QuizTitle</strong><small>@s.CourseTitle · @s.AttemptedAt.ToString("dd MMM yyyy")</small></div><span class="score-pill @(s.Passed?"pass":"fail")">@s.Score% · @(s.Passed?"Pass":"Retry")</span></div>}@if(!Model.RecentQuizScores.Any()){<p class="text-muted">No assessment attempts yet.</p>}</div></div><div class="col-lg-5"><div class="section-heading"><div><span class="eyebrow">ACHIEVEMENTS</span><h3>Badge cabinet</h3></div></div><div class="badge-grid">@foreach(var b in Model.Badges){<div class="badge-card"><img src="@(b.ImageUrl ?? "/images/badge-certified.svg")" alt="@b.Title"/><strong>@b.Title</strong><small>@b.AwardedAt.ToString("dd MMM yyyy")</small></div>}@if(!Model.Badges.Any()){<p class="text-muted">Your first badge appears after you complete a pathway and pass its final assessment.</p>}</div></div></div></div>
