@model QuizResultViewModel
@{ ViewData["Title"] = "Assessment Result"; }
<div class="result-page"><div class="result-card">@if(Model.Passed){<img class="result-badge" src="/images/badge-certified.svg" alt="Certified badge"/><div class="eyebrow">ASSESSMENT PASSED</div><h1>Well done.</h1>}else{<div class="result-icon">↻</div><div class="eyebrow">KEEP PRACTISING</div><h1>Try the assessment again.</h1>}<div class="score-big">@Model.Score%</div><p class="text-muted">Pass mark: @Model.PassPercentage%</p>@if(Model.CourseCompleted){<div class="completion-panel"><h4>🏅 Pathway completed</h4><p>You completed every chapter and passed the final assessment. Your certification badge has been added to your student dashboard.</p></div>}else if(Model.Passed){<div class="alert alert-info">The assessment is passed. Complete every chapter to unlock the final course badge.</div>}<a class="btn btn-ss-primary" asp-action="Dashboard">Back to student dashboard</a></div></div>
