@model QuizTakeViewModel
@{ ViewData["Title"] = "Assessment"; }
<div class="assessment-hero"><div class="container py-5"><span class="eyebrow">COURSE ASSESSMENT</span><h1>@Model.QuizTitle</h1><p class="lead">Answer every question carefully. Your score is recorded and the assessment can be retaken.</p></div></div><div class="container py-5" style="max-width:900px"><form asp-action="SubmitQuiz" method="post">@Html.AntiForgeryToken()<input type="hidden" name="quizId" value="@Model.QuizId"/>@for(int i=0;i<Model.Questions.Count;i++){var q=Model.Questions[i];<div class="question-card"><div class="question-number">@(i+1). </div><h4>@q.QuestionText</h4><div class="option-stack">@foreach(var o in q.Options){<label class="quiz-option"><input type="radio" name="answers[@q.QuestionId]" value="@o.OptionId" required/><span>@o.OptionText</span></label>}</div></div>}<button class="btn btn-ss-primary btn-lg w-100">Submit assessment</button></form></div>
