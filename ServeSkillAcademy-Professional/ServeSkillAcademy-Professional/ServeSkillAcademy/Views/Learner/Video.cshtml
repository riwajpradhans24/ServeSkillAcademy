@model Video
@{ ViewData["Title"] = Model.Title; }
<div class="container py-5" style="max-width:960px"><div class="eyebrow">LEARNING VIDEO</div><h1 class="fw-bold">@Model.Title</h1><p class="text-muted">@Model.Description</p><div class="video-player-shell"><div class="ratio ratio-16x9"><iframe src="@Model.VideoUrl" title="@Model.Title" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div></div><div class="d-flex justify-content-between mt-4"><span class="badge bg-soft-green">@Model.DurationMinutes minutes</span><a class="btn btn-outline-dark" asp-action="Lesson" asp-route-courseId="@Model.CourseId">Back to learning studio</a></div></div>
