@model List<Category>
@{ ViewData["Title"] = "Manage Categories"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage Categories</h1>
    <a class="btn btn-ss-primary" asp-action="Create">+ New Category</a>
</div>

<table class="table table-hover bg-white">
    <thead><tr><th>Name</th><th>Description</th><th>Courses</th><th></th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Description</td>
                <td>@c.Courses.Count</td>
                <td>
                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@c.CategoryId">Edit</a>
                    <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
