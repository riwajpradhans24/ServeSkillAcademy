<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServeSkill Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="ss-admin-body">
    <nav class="navbar navbar-dark ss-navbar">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Dashboard" asp-action="Index">🍽️ ServeSkill Admin</a>
            <div>
                <a class="btn btn-outline-light btn-sm" asp-controller="Home" asp-action="Index">View Site</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="d-flex">
        <aside class="ss-admin-sidebar p-3">
            <ul class="nav flex-column">
                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">👥 Manage Users</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">🏷️ Manage Categories</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index">📚 Manage Courses</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="Index">💳 Payments</a></li>
            </ul>
        </aside>

        <div class="flex-grow-1 p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
