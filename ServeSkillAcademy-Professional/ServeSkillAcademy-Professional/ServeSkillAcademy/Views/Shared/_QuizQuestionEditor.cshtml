@model (QuizQuestionInput Question, int Index)
@{
    var idx = Model.Index == -1 ? "__index__" : Model.Index.ToString();
    var q = Model.Question;
}
<div class="question-block border rounded p-3 mb-3" data-question-index="@idx">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Question</h6>
        <button type="button" class="btn btn-sm btn-outline-danger remove-question-btn">Remove</button>
    </div>
    <input type="hidden" name="Questions[@idx].QuestionId" value="@q.QuestionId" />
    <div class="mb-2">
        <input type="text" name="Questions[@idx].QuestionText" value="@q.QuestionText" class="form-control" placeholder="Question text" />
    </div>
    <div class="mb-1 small text-muted">Fill in the options and tick the correct one:</div>
    @for (int j = 0; j < q.Options.Count; j++)
    {
        var opt = q.Options[j];
        <div class="input-group mb-1">
            <div class="input-group-text">
                <input type="hidden" name="Questions[@idx].Options[@j].IsCorrect" value="false" />
                <input type="checkbox" name="Questions[@idx].Options[@j].IsCorrect" value="true" checked="@opt.IsCorrect" />
            </div>
            <input type="hidden" name="Questions[@idx].Options[@j].OptionId" value="@opt.OptionId" />
            <input type="text" name="Questions[@idx].Options[@j].OptionText" value="@opt.OptionText" class="form-control" placeholder="Option @(j + 1)" />
        </div>
    }
</div>
