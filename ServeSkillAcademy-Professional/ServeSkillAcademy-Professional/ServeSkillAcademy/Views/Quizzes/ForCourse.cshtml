@model Course
@{ ViewData["Title"] = "Quizzes — " + Model.Title; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h6 class="text-muted mb-0">@Model.Title</h6>
        <h1>Quizzes</h1>
    </div>
    <a class="btn btn-ss-primary" asp-action="Create" asp-route-courseId="@Model.CourseId">+ New Quiz</a>
</div>

<table class="table table-hover bg-white">
    <thead><tr><th>Title</th><th>Pass %</th><th>Questions</th><th></th></tr></thead>
    <tbody>
        @foreach (var q in Model.Quizzes)
        {
            <tr>
                <td>@q.Title</td>
                <td>@q.PassPercentage%</td>
                <td>@q.Questions.Count</td>
                <td>
                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@q.QuizId">Edit</a>
                    <form asp-action="Delete" asp-route-id="@q.QuizId" method="post" class="d-inline" onsubmit="return confirm('Delete this quiz?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.Quizzes.Any())
{
    <p class="text-muted">No quizzes yet — add the first one.</p>
}
<a class="btn btn-link px-0" asp-controller="Courses" asp-action="Index">&larr; Back to all courses</a>
