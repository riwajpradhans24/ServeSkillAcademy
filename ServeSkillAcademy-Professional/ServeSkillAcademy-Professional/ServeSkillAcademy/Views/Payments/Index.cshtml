@model List<PaymentTransaction>
@{ ViewData["Title"] = "Payments"; }
<div class="container py-5">
<h1>Payment Verification</h1><p class="text-muted">Review eSewa, bank and card payment requests before granting paid-course access.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>User</th><th>Course</th><th>Method</th><th>Amount</th><th>Reference</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var p in Model){<tr><td>@p.User?.Email</td><td>@p.Course?.Title</td><td>@p.PaymentMethod</td><td>NPR @p.Amount.ToString("N0")</td><td>@p.TransactionReference</td><td><span class="badge @(p.Status=="Approved"?"bg-success":p.Status=="Rejected"?"bg-danger":"bg-warning text-dark")">@p.Status</span></td><td>@if(p.Status=="Pending"){<form asp-action="Approve" asp-route-id="@p.PaymentTransactionId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Approve</button></form><form asp-action="Reject" asp-route-id="@p.PaymentTransactionId" method="post" class="d-inline ms-1">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Reject</button></form>}</td></tr>}
</tbody></table></div></div>
